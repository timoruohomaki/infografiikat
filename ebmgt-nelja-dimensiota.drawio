<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="ebmgt-nelja-dimensiota" name="EBMgt - neljä dimensiota">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="otsikko" value="Evidence Based Management — neljä dimensiota" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="120" y="30" width="610" height="30" as="geometry" />
        </mxCell>
        <mxCell id="alaotsikko" value="Parhaaseen saatavilla olevaan evidenssiin perustuva etätyömallin muutospäätös" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="120" y="58" width="610" height="20" as="geometry" />
        </mxCell>

        <mxCell id="dim1" value="&lt;b&gt;1. Tieteellinen tutkimus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Vertaisarvioitu näyttö etätyön vaikutuksista tuottavuuteen ja hyvinvointiin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=1;fontColor=#042C53;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dim2" value="&lt;b&gt;2. Organisaation data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Oman organisaation mittarit: läsnäolo, suoritus, tilakustannukset ja poissaolot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=1;fontColor=#04342C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="100" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dim3" value="&lt;b&gt;3. Sidosryhmien näkemykset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Henkilöstön, esihenkilöiden ja asiakkaiden arvot, odotukset ja huolet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAECE7;strokeColor=#993C1D;strokeWidth=1;fontColor=#4A1B0C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dim4" value="&lt;b&gt;4. Ammatillinen asiantuntemus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Johdon ja asiantuntijoiden kokemustieto ja harkittu ammatillinen arviointi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=1;fontColor=#26215C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="arviointi" value="&lt;b&gt;Kriittinen arviointi ja yhdistäminen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Evidenssin luotettavuuden ja relevanssin punninta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1EFE8;strokeColor=#5F5E5A;strokeWidth=1;fontColor=#2C2C2A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="275" y="380" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="paatos" value="&lt;b&gt;Päätös: etätyömallin muutos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Perusteltu, evidenssiin nojaava ja seurattava ratkaisu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=2;fontColor=#042C53;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="235" y="500" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5F5E5A;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="dim1" target="arviointi">
