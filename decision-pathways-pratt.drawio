<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="decision-pathways-pratt" name="Decision Intelligence - Pratt CDD / decision pathways">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="otsikko" value="Decision Intelligence — Prattin decision pathways -malli (Causal Decision Diagram, CDD)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="alaotsikko" value="Toiminnasta lopputuloksiin kulkeva polku: päätösvivut ja ulkoiset tekijät kytkeytyvät välimuuttujien kautta tavoiteltuihin lopputuloksiin. Data ja koneoppiminen liittyvät polun keskelle." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="60" y="54" width="980" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sarake_paatos" value="Päätöksentekijän hallinnassa" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sarake_keski" value="Syy-seurausketju — datan ja koneoppimisen kytkentäkohta" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sarake_loppu" value="Tavoiteltu lopputulos" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="levers" value="&lt;b&gt;Päätösvivut (Levers)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Toisensa poissulkevat valinnat, jotka ovat päätöksentekijän vallassa. Niistä syntyy toiminta (action).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=1;fontColor=#26215C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="externals" value="&lt;b&gt;Ulkoiset tekijät (Externals)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tekijät, jotka vaikuttavat lopputulokseen mutta eivät ole päätöksentekijän hallinnassa (esim. markkina, sää, lainsäädäntö).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FAEEDA;strokeColor=#854F0B;strokeWidth=1;fontColor=#412402;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="intermediate1" value="&lt;b&gt;Välimuuttuja (Intermediate)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Syy-seurausketjun välivaihe. Vivuilla ja ulkoisilla tekijöillä tuotettu tieto, esim. laskettu riski- tai kysyntäarvio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=1;fontColor=#042C53;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="intermediate2" value="&lt;b&gt;Välimuuttuja (Intermediate)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ketjut voivat olla monivaiheisia: yksi välimuuttuja voi vaikuttaa kausaalisesti toiseen ennen lopputulosta.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=1;fontColor=#042C53;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="430" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="outcomes" value="&lt;b&gt;Lopputulokset (Outcomes)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Toiminnan mitattavat seuraukset. Toistuvissa päätöksissä lopputulokset tuottavat opetusdataa koneoppimismalleille.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=1;fontColor=#04342C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="240" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="objective" value="&lt;b&gt;Tavoite (Objective)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Mitattava päämäärä, jota vasten lopputuloksia arvioidaan.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=2;fontColor=#04342C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="430" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="data_merkki" value="&lt;b&gt;ML&lt;/b&gt;" style="triangle;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;strokeWidth=1;fontColor=#2C2C2A;direction=east;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="345" y="206" width="36" height="38" as="geometry" />
        </mxCell>
        <mxCell id="data_selite" value="Datan, analytiikan ja koneoppimisen kytkentäkohta (kolmio merkitsee ML-mallia linkillä)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="130" height="40" as="geometry" />
        </mxCell>

        <mxCell id="selite" value="Prattin Causal Decision Diagram (CDD) on Decision Intelligence -menetelmän perusrakenne: se tekee näkyväksi riippuvuusketjut (Dependencies, nuolet), jotka kytkevät päätöksentekijän toiminnan ja ulkoiset tekijät tavoiteltuihin lopputuloksiin. Tuntemattomat arvot tai suhteet ketjussa osoittavat täsmälleen ne kohdat, joissa data-analytiikkaa tai koneoppimista tarvitaan. Polku kulkee toiminnasta lopputulokseen (action-to-outcome pathway), ja simulaatiolla mallilla voidaan tutkia, mihin lopputuloksiin eri vivun asetukset todennäköisesti johtavat." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1000" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e_levers_int1" value="Dependency" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#534AB7;strokeWidth=1.5;fontSize=10;fontColor=#534AB7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="levers" target="intermediate1">
