        <mxCell id="vaikuttavuus" value="&lt;b&gt;Yhteiskunnallinen vaikuttavuus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Lopputulokset ja vaikutukset asukkaille, yrityksille ja yhteisöille — korvaa Kaplanin asiakasnäkökulman&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E1F5EE;strokeColor=#0F6E56;strokeWidth=1;fontColor=#04342C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="100" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="prosessit" value="&lt;b&gt;Prosessit ja rakenteet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Kunnan hallinnassa olevat prosessit ja rakenteet, joiden toimivuus tuottaa laadukkaat palvelut ja positiiviset vaikutukset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=1;fontColor=#042C53;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="306" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="talous" value="&lt;b&gt;Talouden ja resurssien hallinta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Määrärahojen ja tulojen hallinta, joka osoittaa voimavarojen taloudellisen, tuottavan ja tehokkaan käytön&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAEEDA;strokeColor=#854F0B;strokeWidth=1;fontColor=#412402;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="306" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="uudistuminen" value="&lt;b&gt;Osaamisen uudistaminen ja henkilöstön työkykyisyys&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Palveluiden ja toimintatapojen uudistuminen sekä henkilöstön osaamisen ja työkyvyn kehittyminen — koko ketjun perusta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EEEDFE;strokeColor=#534AB7;strokeWidth=1;fontColor=#26215C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
