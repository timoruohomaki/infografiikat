        </mxCell>

        <mxCell id="selite" value="Asettelu noudattaa Kaplanin BSC-hierarkiaa: alimman tason uudistuminen ja työkykyisyys kantavat keskitason taloutta ja prosesseja, jotka tuottavat ylimmän tason yhteiskunnallista vaikuttavuutta. Visio on kaiken keskiössä." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;spacingLeft=4;" vertex="1" parent="1">
