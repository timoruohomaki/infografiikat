        <mxCell id="otsikko" value="Tasapainotettu tuloskortti julkishallinnossa — neljä dimensiota" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A2E;" vertex="1" parent="1">
