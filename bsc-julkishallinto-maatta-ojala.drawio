<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="bsc-julkishallinto-maatta-ojala" name="Julkishallinnon BSC - Määttä &amp; Ojala">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
