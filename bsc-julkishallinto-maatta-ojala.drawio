        <mxCell id="taso_keski" value="Keskitaso — keinot" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="taso_alin" value="Alin taso — perusta" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="120" height="20" as="geometry" />
