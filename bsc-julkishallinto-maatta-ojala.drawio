        <mxCell id="visio" value="&lt;b&gt;Kunnan visio&lt;br&gt;ja perustehtävä&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Mihin onnistumisella tähdätään&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;strokeWidth=2;fontColor=#2C2C2A;align=center;verticalAlign=middle;" vertex="1" parent="1">
