          <mxGeometry x="120" y="52" width="610" height="20" as="geometry" />
        </mxCell>

        <mxCell id="taso_ylin" value="Ylin taso — päämäärä" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888780;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="120" height="20" as="geometry" />
